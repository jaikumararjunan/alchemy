# ─────────────────────────────────────────────────────────────────────────────
# Alchemy Platform — Local Docker Environment
# Ready to use — no editing required for local development
# ─────────────────────────────────────────────────────────────────────────────

ENV=development
LOG_LEVEL=info
ENABLE_AI_AGENTS=false

# ── Security (pre-generated for local dev — CHANGE FOR PRODUCTION) ────────────
JWT_SECRET_KEY=AlchemyLocalDev!JWT_Secret_Key_32chars_Min_2024
ALCHEMY_VAULT_KEY=AlchemyLocalDev!Vault_Key_32chars_Min2024
ALCHEMY_FERNET_KEY=

# ── Database (SQLite — no PostgreSQL needed for local) ────────────────────────
DATABASE_URL=sqlite+aiosqlite:////app/data/alchemy.db

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis disabled for local Docker (uses in-memory fallback)
REDIS_URL=

# ── Admin credentials (auto-created on first startup) ────────────────────────
ADMIN_EMAIL=admin@alchemy.in
ADMIN_PASSWORD=Alchemy#Admin!2024

# ── LLM providers (optional — AI signals disabled without these) ──────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Exchange API keys (optional — all gateways default to paper mode) ─────────
DELTA_API_KEY=
DELTA_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
ANGEL_API_KEY=
KITE_API_KEY=
KITE_API_SECRET=

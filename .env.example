# ─────────────────────────────────────────────────────────────────────────────
# Alchemy Platform v0.4 — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
ENV=development                          # development | production
LOG_LEVEL=info                           # debug | info | warning | error
ENABLE_AI_AGENTS=true

# ── Security — CHANGE ALL OF THESE ───────────────────────────────────────────
# JWT signing secret — minimum 32 characters, use: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_MINIMUM_32_CHARS_OPENSSL_RAND_HEX_32

# Vault master key for AES-256-GCM token encryption — 32 chars minimum
ALCHEMY_VAULT_KEY=CHANGE_ME_MINIMUM_32_CHARS_VAULT_MASTER_KEY_XXXX

# Fernet key for TOTP secret encryption — generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ALCHEMY_FERNET_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for development (auto-created)
DATABASE_URL=sqlite+aiosqlite:///./alchemy_dev.db

# PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://alchemy:your_db_password@localhost:5432/alchemy

DB_PASSWORD=change_me_in_production
DB_USER=alchemy

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=change_me

# ── Admin Bootstrap ───────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@alchemy.in
ADMIN_PASSWORD=CHANGE_ME_NOW_Admin!2024

# ── LLM Providers ────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LITELLM_PROXY_URL=http://localhost:4000

# ── Exchange API Keys (optional — can be set via /tokens/register) ────────────
# Delta Exchange
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_TESTNET=true

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Angel Broking SmartAPI
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Zerodha Kite
KITE_API_KEY=
KITE_API_SECRET=

# Interactive Brokers
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# ─────────────────────────────────────────────────────────────────────────────
# Alchemy — PRODUCTION Environment Template
# Location on VPS: /opt/alchemy/.env.production
# NEVER commit the real .env.production file (it is git-ignored)
#
# Generate secrets:
#   openssl rand -base64 48 | tr -dc 'A-Za-z0-9!@#' | head -c 40
# ─────────────────────────────────────────────────────────────────────────────
ENV=production
LOG_LEVEL=info
ENABLE_AI_AGENTS=false

# ── SECURITY (change all of these) ───────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_40_CHARS_WITH_SPECIAL_CHARS!!
ALCHEMY_VAULT_KEY=CHANGE_ME_40_CHARS_WITH_SPECIAL_CHARS!!

# ── DATABASE ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:////data/alchemy.db

# ── ADMIN (change password — must have upper+lower+digit+special) ─────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourStrong#Password2024!

# ── DOMAIN (used in notification links) ──────────────────────────────────────
DOMAIN=yourdomain.com

# ── EMAIL OTP (Gmail App Password) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_FROM=your@gmail.com
